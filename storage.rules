rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read access for all files in the bucket
    match /{allPaths=**} {
      allow read: if true;
    }

    // Rules for user profile images (owners and service providers)
    // Supports paths like users/{userId}/owner/avatar.jpg or service_providers/{userId}/profile.jpg
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /service_providers/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for adoption listings
    // Allows any authenticated user to upload a photo for a listing
    match /adoption-listings/{fileName} {
      allow write: if request.auth != null;
    }
  }
}