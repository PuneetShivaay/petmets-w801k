rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all images
    match /{allPaths=**} {
      allow read: if true;
    }

    // User-specific folders
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Service provider specific folders
    // We match both with and without the recursive allPaths to be safe
    match /service_providers/{providerId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == providerId;
    }

    // Adoption listings images
    match /adoption-listings/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
