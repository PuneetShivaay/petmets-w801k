rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read access for all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Explicit rules for service providers
    match /service_providers/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Explicit rules for users/owners
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Adoption listings
    match /adoption-listings/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}