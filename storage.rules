rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Explicitly allow writes to service provider directories by the owner
    match /service_providers/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Explicitly allow writes to user profile directories by the owner
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Explicitly allow writes to adoption listings by any authenticated user
    match /adoption-listings/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}