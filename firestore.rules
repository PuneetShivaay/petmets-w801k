rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn(); // Allow listing users for chat/match info
      allow create, update, delete: if isOwner(userId);
    }

    // --- Pets (Top-level, keyed by userId) ---
    match /pets/{userId} {
      allow get, list: if true; // Publicly searchable for matching
      allow create, update, delete: if isOwner(userId);
    }

    // --- Bookings ---
    match /bookings/{bookingId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId || 
        request.auth.uid == resource.data.serviceProviderId
      );
      // Ensure only the owner can create a booking for themselves
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // Allow cancellation by either party
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId || 
        request.auth.uid == resource.data.serviceProviderId
      );
    }

    // --- Service Providers ---
    match /service_providers/{providerId} {
      allow get, list: if true; // Publicly searchable
      allow create, update, delete: if isOwner(providerId);
    }

    // --- Adoption Listings ---
    match /adoptionListings/{listingId} {
      allow get, list: if true;
      // Anyone logged in can create a listing
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // Only the owner can manage their listing
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // --- Match Requests ---
    match /matchRequests/{requestId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid == resource.data.requesterId || 
        request.auth.uid == resource.data.targetOwnerId
      );
      // Ensure only the requester can create the request
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid;
      // Both parties can respond (update status)
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.requesterId || 
        request.auth.uid == resource.data.targetOwnerId
      );
    }

    // --- Chats ---
    match /chats/{chatId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participants;
      // Verify creating user is a participant
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        // Use get() to check parent chat participants for message access
        allow get, list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}