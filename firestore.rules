rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DEVELOPMENT RULES: Permissive access for prototyping.
     * WARNING: These rules allow anyone to read and write any data.
     * Before going to production, these must be restricted.
     */
    
    match /{document=**} {
      // Allow read and write access to all documents until the specified date
      allow read, write: if request.time < timestamp.date(2029, 8, 9);
    }

    // --- Specific collection paths maintained for architectural clarity ---
    
    match /users/{userId} {
      allow read, write: if true;
    }

    match /pets/{userId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /service_providers/{providerId} {
      allow read, write: if true;
    }

    match /adoptionListings/{listingId} {
      allow read, write: if true;
    }

    match /matchRequests/{requestId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}