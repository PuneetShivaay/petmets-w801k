
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all reads/writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read and write to their own user data
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
    }

    // Allow authenticated users to read and write to their own pet data
    match /users/{userId}/pets/{petId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Allow any authenticated user to create match requests
    match /matchRequests/{requestId} {
        allow create: if request.auth != null;
        allow read, update: if request.auth.uid == resource.data.targetOwnerId;
    }

    // Allow participants to read/write chat messages
    match /chats/{chatId} {
      allow read, update: if request.auth.uid in resource.data.participants;
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
    
    // Allow any authenticated user to create an adoption listing
    match /adoptionListings/{listingId} {
      allow create: if request.auth != null;
      allow read: if true; // Allow anyone to read listings
    }
    
    // Allow users to read from the 'pets' collection group
    match /users/{userId}/pets/{petId} {
        allow get, list: if request.auth != null;
    }
  }
}
