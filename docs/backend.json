
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the PetMets application, storing their profile information and role.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "name": {
          "type": "string",
          "description": "The display name of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user (e.g., 'owner', 'provider').",
          "enum": ["owner", "provider"]
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the user."
        },
        "avatar": {
          "type": "string",
          "description": "URL to the user's profile picture.",
          "format": "uri"
        },
        "address": {
          "type": "string",
          "description": "The street address of the user."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "createdAt"
      ]
    },
    "Pet": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Pet",
      "type": "object",
      "description": "Represents a pet owned by a user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Pet entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the User who owns this pet."
        },
        "name": {
          "type": "string",
          "description": "The name of the pet."
        },
        "breed": {
          "type": "string",
          "description": "The breed of the pet."
        },
        "age": {
          "type": "string",
          "description": "The age of the pet."
        },
        "gender": {
          "type": "string",
          "description": "The gender of the pet."
        },
        "bio": {
          "type": "string",
          "description": "Bio for the pet."
        },
        "avatar": {
          "type": "string",
          "description": "URL to the pet's picture.",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "createdAt"
      ]
    },
    "ServiceProvider": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ServiceProvider",
      "type": "object",
      "description": "Represents a pet service provider.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (matches User UID)."
        },
        "name": {
          "type": "string",
          "description": "Business name."
        },
        "service": {
          "type": "string",
          "description": "Primary service offered."
        },
        "bio": {
          "type": "string",
          "description": "Business description."
        },
        "location": {
          "type": "string",
          "description": "City or area of operation."
        },
        "image": {
          "type": "string",
          "description": "URL to profile image."
        },
        "rating": {
          "type": "number",
          "description": "Average rating."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "service",
        "createdAt"
      ]
    },
    "AdoptionListing": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdoptionListing",
      "type": "object",
      "description": "A pet listed for adoption.",
      "properties": {
        "id": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "breed": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "description": "User profiles."
        }
      },
      {
        "path": "/users/{userId}/pets/{petId}",
        "definition": {
          "entityName": "Pet",
          "description": "User's pets."
        }
      },
      {
        "path": "/service_providers/{providerId}",
        "definition": {
          "entityName": "ServiceProvider",
          "description": "Public provider profiles."
        }
      },
      {
        "path": "/adoptionListings/{listingId}",
        "definition": {
          "entityName": "AdoptionListing",
          "description": "Pets for adoption."
        }
      }
    ]
  }
}
